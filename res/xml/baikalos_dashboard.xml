<PreferenceScreen 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/baikalos_settings_title"
    android:key="baikalos_top_level_settings">

    <PreferenceCategory
        android:layout="@layout/settingslib_expressive_untitled_preference_category">

        <PreferenceScreen
            android:title="@string/settings_app_title"
            android:summary="@string/settings_app_summary"
            android:icon="@drawable/ic_homepage_apps"
            android:fragment="ru.baikalos.settings.fragments.Apps" />

        <PreferenceScreen
            android:key="powersave_pref"
            android:title="@string/powersave_title"
            android:summary="@string/powersave_summary"
            android:icon="@drawable/ic_settings_powersave"
            android:fragment="ru.baikalos.settings.fragments.PowerSave" />

        <PreferenceScreen
            android:title="@string/misc_title"
            android:summary="@string/misc_summary"
            android:icon="@drawable/ic_settings_misc"
            android:fragment="ru.baikalos.settings.fragments.Miscellaneous" />

        <!-- PreferenceScreen
            android:title="@string/services_title"
            android:summary="@string/services_summary"
            android:icon="@drawable/ic_settings_services"
            android:fragment="com.crdroid.settings.fragments.Services" / -->

        <PreferenceScreen
            android:title="@string/device_title"
            android:summary="@string/device_summary"
            android:icon="@drawable/ic_settings_misc"
            android:fragment="ru.baikalos.settings.fragments.Device" />

        <PreferenceScreen
            android:title="@string/privacy_title"
            android:summary="@string/privacy_summary"
            android:icon="@drawable/ic_privacy"
            android:fragment="ru.baikalos.settings.fragments.Privacy" />

        <PreferenceScreen
            android:key="smart_trust"
            android:title="@string/smart_trust_title"
            android:summary="@string/smart_trust_summary"
            android:icon="@drawable/ic_settings_smart_trust"
            android:fragment="ru.baikalos.settings.fragments.SmartTrust" />

        <PreferenceScreen
            android:title="@string/special_devices_title"
            android:summary="@string/special_devices_summary"
            android:icon="@drawable/ic_settings_special_devices"
            android:fragment="ru.baikalos.settings.fragments.SpecialDevices" />


        <PreferenceScreen
            android:key="experimental_crdroid"
            android:title="@string/experimental_crdroid"
            android:summary="@string/experimental_summary"
            android:icon="@drawable/ic_settings_device"
            android:fragment="ru.baikalos.settings.fragments.Experimental"/>

        <PreferenceScreen
            android:key="about_baikalos"
            android:title="@string/about_baikalos"
            android:summary="@string/about_summary"
            android:icon="@drawable/ic_settings_about"
            android:fragment="ru.baikalos.settings.fragments.About" />


    </PreferenceCategory>

</PreferenceScreen>
